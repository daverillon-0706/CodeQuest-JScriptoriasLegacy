                }, 
                {
                 "height":16,
                 "id":18,
                 "name":"kaelen",
                 "properties":[
                        {
                         "name":"kaelen dialogue",
                         "type":"string",
                         "value":"[\"Yo, buddy!\", \"This is just a precaution before you venture out on the outskirts of the city.\", \"In front of you is a bug that we, the guild members, have caught.\", \"It is a struggle, but we want you to test it for a debugging battle, and prove that you are capable of handling them.\", \"Good luck buddy!\"]"
                        }],
                 "rotation":0,
                 "type":"",
                 "visible":true,
                 "width":16,
                 "x":176.333,
                 "y":416
                }, 
                {
                 "height":16,
                 "id":19,
                 "name":"selena",
                 "properties":[
                        {
                         "name":"selena dialogue",
                         "type":"string",
                         "value":"[\"Oh, it's you.\", \"As you can see, we are here to witness your skills as a debugger.\", \"Now in front of you is a bug the guild members caught.\", \"Like everyone said, debug it and win.\", \"Good luck.\"]"
                        }],
