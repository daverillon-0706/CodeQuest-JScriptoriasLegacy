                }, 
                {
                 "height":16,
                 "id":17,
                 "name":"orin",
                 "properties":[
                        {
                         "name":"orin dialogue",
                         "type":"string",
                         "value":"[\"Oh, it's you.\", \"Let me give you a brief summary.\", \"In front of you is a bug the guild members caught.\", \"You will show me your skills as a debugger for the your future battles to come.\", \"Good luck.\"]"
                        }],
                 "rotation":0,
